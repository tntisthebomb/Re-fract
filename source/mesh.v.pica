.fvec projection[4]
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outclr color
.alias inpos v0
.alias inclr v1
.proc main
 mov r0.xyz, inpos
 mov r0.w, constants.y
 dp4 outpos.x, projection[0], r0
 dp4 outpos.y, projection[1], r0
 dp4 outpos.z, projection[2], r0
 dp4 outpos.w, projection[3], r0
 mov outclr.xyz, inclr
 mov outclr.w, constants.y
 end
.end
